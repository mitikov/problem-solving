<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram name="01-Картки" id="01-Картки"><mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="01 / Симптом, потреба чи реалізація?" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=8;fontSize=30;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="30" y="15" width="1110" height="55" as="geometry"/></mxCell><mxCell id="3" value="Перетягніть усі шість карток у зони. Пояснення та прогноз запишіть у звіті." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=8;" vertex="1" parent="1" ><mxGeometry x="30" y="75" width="1110" height="45" as="geometry"/></mxCell><mxCell id="4" value="СИМПТОМ" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontFamily=Arial;fontColor=#16324F;fontSize=22;spacing=16;arcSize=6;container=0;movable=0;resizable=0;" vertex="1" parent="1" ><mxGeometry x="30" y="135" width="360" height="375" as="geometry"/></mxCell><mxCell id="5" value="ПОТРЕБА" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontFamily=Arial;fontColor=#16324F;fontSize=22;spacing=16;arcSize=6;container=0;movable=0;resizable=0;" vertex="1" parent="1" ><mxGeometry x="415" y="135" width="360" height="375" as="geometry"/></mxCell><mxCell id="6" value="РЕАЛІЗАЦІЯ" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontFamily=Arial;fontColor=#16324F;fontSize=22;spacing=16;arcSize=6;container=0;movable=0;resizable=0;" vertex="1" parent="1" ><mxGeometry x="800" y="135" width="360" height="375" as="geometry"/></mxCell><mxCell id="7" value="А · Після обіду предмети лежать біля контейнера." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#94A3B8;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=14;arcSize=12;" vertex="1" parent="1" ><mxGeometry x="45" y="555" width="330" height="100" as="geometry"/></mxCell><mxCell id="8" value="Б · Працівнику потрібно вчасно знати про заповнення." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#94A3B8;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=14;arcSize=12;" vertex="1" parent="1" ><mxGeometry x="430" y="555" width="330" height="100" as="geometry"/></mxCell><mxCell id="9" value="В · Встановити ультразвуковий датчик." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#94A3B8;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=14;arcSize=12;" vertex="1" parent="1" ><mxGeometry x="815" y="555" width="330" height="100" as="geometry"/></mxCell><mxCell id="10" value="Г · Індикатор показує червоне після спорожнення." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#94A3B8;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=14;arcSize=12;" vertex="1" parent="1" ><mxGeometry x="45" y="675" width="330" height="100" as="geometry"/></mxCell><mxCell id="11" value="Д · Відвідувачу потрібно знайти придатне місце здавання." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#94A3B8;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=14;arcSize=12;" vertex="1" parent="1" ><mxGeometry x="430" y="675" width="330" height="100" as="geometry"/></mxCell><mxCell id="12" value="Е · Надсилати повідомлення через Wi-Fi." style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#94A3B8;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=14;arcSize=12;" vertex="1" parent="1" ><mxGeometry x="815" y="675" width="330" height="100" as="geometry"/></mxCell><mxCell id="13" value="Копію картки В створіть після першої класифікації. Ctrl+C / Ctrl+V; подвійне клацання змінює текст." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=8;fontSize=15;" vertex="1" parent="1" ><mxGeometry x="30" y="790" width="1120" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="02-Система" id="02-Система"><mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="14" value="02 / Карта системи" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=8;fontSize=30;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="30" y="15" width="1110" height="55" as="geometry"/></mxCell><mxCell id="15" value="Питання карти: [заповніть у звіті або тут]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#16324F;fontSize=18;spacing=8;" vertex="1" parent="1" ><mxGeometry x="30" y="75" width="1110" height="50" as="geometry"/></mxCell><mxCell id="16" value="МЕЖА СИСТЕМИ — змініть відповідно до свого питання" style="rounded=0;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=#16324F;strokeWidth=2;dashed=1;fontFamily=Arial;fontSize=19;spacing=14;container=0;" vertex="1" parent="1" ><mxGeometry x="40" y="155" width="600" height="495" as="geometry"/></mxCell><mxCell id="17" value="Підсистема 1
